rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function own(data) { return signedIn() && data.ownerId == request.auth.uid; }
  function str(data, key, max) { return data[key] is string && data[key].size() <= max; }
  function common(data) { return own(data) && str(data,'title',160) && data.title.size()>0 && str(data,'subject',80) && data.createdAt is number; }
  function notice(data) { return data.keys().hasOnly(['title','body','category','subject','dueDate','pinned','done','createdAt','ownerId']) && common(data) && str(data,'body',20000) && data.category in ['학교','학급','수행평가'] && str(data,'dueDate',10) && (data.dueDate == '' || data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) && data.pinned is bool && data.done is bool; }
  function lesson(data) { return data.keys().hasOnly(['title','description','subject','youtubeId','shared','createdAt','ownerId']) && common(data) && str(data,'description',20000) && data.youtubeId is string && data.youtubeId.matches('^[A-Za-z0-9_-]{11}$') && data.shared is bool; }
  match /notices/{id} {
   allow read, delete: if own(resource.data);
   allow create: if notice(request.resource.data);
   allow update: if own(resource.data) && notice(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
  }
  match /lessons/{id} {
   allow get: if resource.data.shared == true || own(resource.data);
   allow list: if own(resource.data);
   allow create: if lesson(request.resource.data);
   allow update: if own(resource.data) && lesson(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
   allow delete: if own(resource.data);
   match /comments/{commentId} {
    function parent() { return get(/databases/$(database)/documents/lessons/$(id)).data; }
    function canView() { return parent().shared == true || own(parent()); }
    allow read: if canView();
    allow create: if signedIn() && canView() && request.resource.data.keys().hasOnly(['lessonId','text','alias','ownerId','createdAt']) && own(request.resource.data) && request.resource.data.lessonId == id && str(request.resource.data,'text',2000) && request.resource.data.text.size()>0 && str(request.resource.data,'alias',30) && request.resource.data.alias.size()>0 && request.resource.data.createdAt is number;
    allow delete: if signedIn() && (own(parent()) || own(resource.data));
   }
  }
  match /users/{uid} {
   allow read: if signedIn() && request.auth.uid == uid;
   allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['bookmarks']) && request.resource.data.bookmarks is list && request.resource.data.bookmarks.size() <= 1000;
  }
 }
}
